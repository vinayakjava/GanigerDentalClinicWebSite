# Public URL of the deployed site, used for canonical links, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ganigerdentalclinic.in

# "true" prints appointment requests to the server console instead of emailing them.
# Use it for local development and tests only; never set it in production.
APPOINTMENT_EMAIL_DRY_RUN=true

# Resend (https://resend.com) — server only.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Dr. Ganiger's Website <appointments@ganigerdentalclinic.in>".
APPOINTMENT_EMAIL_FROM=
# Clinic inbox(es) that receive appointment requests; comma-separate multiple addresses.
APPOINTMENT_EMAIL_TO=lakkappaganiger34@gmail.com
