# Public URL of the deployed site, used for canonical links, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# Resend (https://resend.com) — server only. Leave blank locally to print requests to the console instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Dr. Ganiger's Website <appointments@your-domain>".
APPOINTMENT_EMAIL_FROM=
# Clinic inbox(es) that receive appointment requests; comma-separate multiple addresses.
APPOINTMENT_EMAIL_TO=drlakki34@gmail.com
